<misterromdescription>
	<name>Empire Strikes Back</name>
	<region></region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version></version>
	<alternative></alternative>
	<platform>Atari Vector</platform>
	<series>Star Wars</series>
	<year>1985</year>
	<manufacturer>Atari</manufacturer>
	<category>Shooter</category>

	<setname>esb</setname>
	<parent>starwars</parent>
	<mameversion>0218</mameversion>
	<rbf>Arcade-StarWars</rbf>
	<about>Atari, 1985.  Sister hardware to Star Wars 1983.  Same AVG state
	       PROM (136021-105.1l, CRC 82fc3eb2), same mathbox PROM interface,
	       same audio chain — plus a slapstic chip (137412-101) for copy
	       protection on the $8000-$9FFF page.  Snowspeeder + AT-AT walkers
	       on Hoth, Asteroid field, Death Star trench.</about>

	<resolution>31kHz</resolution>
	<rotation>horizontal</rotation>
	<flip></flip>

	<players>1</players>
	<joystick>Analog</joystick>
	<special_controls>yoke</special_controls>
	<num_buttons>7</num_buttons>
	<buttons default="A,B,Start,R,L,Y,Z" names="Fire L,Shield L,Aux Coin,Coin L,Coin R,Fire R,Shield R"></buttons>

	<!-- mod=1 selects ESB in Arcade-StarWars.sv (TBD: ESB-3 task). -->
	<rom index="1">
		<part>1</part>
	</rom>

	<!-- ROM stream (rom index=0).  Layout MUST match starwars.sv's
	     ESB-mode dn_addr decoders (TBD: ESB-3 task).
	     File names match the user's esb.zip contents (no .1f / .1jk
	     suffix variants).

	     Proposed dn_addr layout for ESB (mod_esb=1):
	       dn 0x00000-0x03FFF  136031.101  (16KB main)
	       dn 0x04000-0x07FFF  136031.102  (16KB main)
	       dn 0x08000-0x0BFFF  136031.203  (16KB main, .203 replaces .103)
	       dn 0x0C000-0x0FFFF  136031.104  (16KB main)
	       dn 0x10000-0x13FFF  136031.105  (16KB slapstic 0+1)
	       dn 0x14000-0x17FFF  136031.106  (16KB slapstic 2+3)
	       dn 0x18000-0x18FFF  136031.111  (4KB vector ROM)
	       dn 0x19000-0x190FF  136021-105.1l (256B AVG state PROM, SAME as SW)
	       dn 0x19100-0x191FF  (256B zero pad for alignment)
	       dn 0x1A000-0x1DFFF  136031.113 + 136031.112 (16KB total audio ROMs)
	       dn 0x1E000-0x1E0FF  136031.107..110 (4KB mathbox PROMs, 4x1KB)
	     Total: ~120 KB.  Requires dn_addr width >= 17 bits (already in our
	     PROM-driven AVG branch).
	  -->
	<rom index="0" md5="none" type="merged|nonmerged" zip="esb.zip">
		<!-- Main CPU ROMs (4 x 16KB = 64KB) -->
		<part crc="ef1e3ae5" name="136031.101"></part>
		<part crc="62ce5c12" name="136031.102"></part>
		<part crc="27b0889b" name="136031.203"></part>
		<part crc="fd5c725e" name="136031.104"></part>

		<!-- Slapstic ROMs (2 x 16KB = 32KB).  Slapstic chip is type 101
		     (137412-101).  4 banks of 8KB each accessible at CPU $8000-$9FFF
		     after the state machine commits a bank switch. -->
		<part crc="ea9e4dce" name="136031.105"></part>
		<part crc="76d07f59" name="136031.106"></part>

		<!-- Vector ROM (4KB) -->
		<part crc="b1f9bd12" name="136031.111"></part>

		<!-- AVG state PROM (256B, IDENTICAL to SW per MAME ROM_START(esb)
		     line 517: same CRC 82fc3eb2).  This file is in esb.zip too. -->
		<part crc="82fc3eb2" name="136021-105.1l"></part>

		<!-- 256B zero pad to align audio ROMs to 0x1A000. -->
		<part repeat="256">00</part>

		<!-- Audio CPU ROMs (2 x 16KB = 32KB).  136031.113 is .107 equivalent
		     in SW; 136031.112 is .208 equivalent.  Audio CPU sees them at
		     $4000-$5FFF (low half of .113), $6000-$7FFF (low half of .112),
		     plus their high halves mirrored at $C000-$DFFF / $E000-$FFFF. -->
		<part crc="24ae3815" name="136031.113"></part>
		<part crc="ca72d341" name="136031.112"></part>

		<!-- Mathbox PROMs (4 x 1KB = 4KB).  Different content from SW but
		     same interface — Videodr0me's structural mathbox uses them
		     directly via the existing dn_mb_cs routing. -->
		<part crc="b8d0f69d" name="136031.110"></part>
		<part crc="6a2a4d98" name="136031.109"></part>
		<!-- (.108 and .107 CRCs TBD — fill in from MAME ROM_START or
		     compute from the actual files in esb.zip.) -->
		<part name="136031.108"></part>
		<part name="136031.107"></part>
	</rom>
	<rom index="2"></rom>
	<rom index="3"></rom>
	<rom index="4"></rom>

	<nvram index="4" size="256"></nvram>

	<remark>Empire Strikes Back port.  Requires mod_esb selector + slapstic
	chip wiring in starwars.sv (see docs/ESB_PLAN.md + docs/ESB_INTEGRATION.md).
	Current branch state: SLAPSTIC.vhd imported from d18c7db's Gauntlet_FPGA
	(GPL-3, same author as our TMS5220.vhd).  Memory-map integration deferred
	to next session.</remark>
</misterromdescription>
